# Local, non-secret application defaults.
# Copy this file to .env to override settings. Never commit .env.
PLP_APP_NAME=Premier League Prediction Platform
PLP_ENVIRONMENT=development
PLP_DEBUG=false
PLP_LOG_LEVEL=INFO

# PostgreSQL 16+ using psycopg 3. Keep development and test databases distinct.
# Replace CHANGE_ME only in the ignored local .env file.
PLP_DATABASE_URL=postgresql+psycopg://pl_app:CHANGE_ME@localhost:5432/pl_platform_dev
PLP_TEST_DATABASE_URL=postgresql+psycopg://pl_app:CHANGE_ME@localhost:5432/pl_platform_test
PLP_DATABASE_CONNECT_TIMEOUT_SECONDS=5
PLP_DATABASE_POOL_SIZE=5
PLP_DATABASE_MAX_OVERFLOW=5
